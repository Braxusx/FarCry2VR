#include "payload_ids.h"
IDI_APP       ICON    "launcher.ico"
IDR_DINPUT8   RCDATA  "dinput8.dll"
IDR_OPENXR    RCDATA  "openxr_loader.dll"
IDR_DLSS_HOST RCDATA  "fc2vr_dlss_host64.exe"
IDR_NGX_DLSS  RCDATA  "nvngx_dlss.dll"
IDR_INI       RCDATA  "fc2vr.ini"
1 24 "launcher.manifest"
1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Far Cry 2 VR Launcher"
      VALUE "ProductName", "Far Cry 2 VR"
      VALUE "FileVersion", "1.0.3"
      VALUE "ProductVersion", "1.0.3"
      VALUE "CompanyName", "Braxus"
      VALUE "LegalCopyright", "Far Cry VR Mod by Braxus"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
