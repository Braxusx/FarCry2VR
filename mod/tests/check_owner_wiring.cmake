# Source topology guards, not execution, lifetime/refcount or worker proof.
foreach(name arms main controls gameaddr)
    file(READ "${SOURCE_DIR}/${name}.cpp" ${name})
endforeach()
function(require_text source needle)
    string(FIND "${${source}}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing owner/image wiring in ${source}: ${needle}")
    endif()
endfunction()
function(require_order source first second)
    string(FIND "${${source}}" "${first}" a)
    string(FIND "${${source}}" "${second}" b)
    if(a LESS 0 OR b LESS 0 OR NOT a LESS b)
        message(FATAL_ERROR "Incorrect owner/image order in ${source}: ${first} -> ${second}")
    endif()
endfunction()
