function(require_text source needle)
    string(FIND "${${source}}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing ${source} wiring: ${needle}")
    endif()
endfunction()
function(require_count source needle count)
    string(REGEX MATCHALL "${needle}" matches "${${source}}")
    list(LENGTH matches actual)
    if(NOT actual EQUAL count)
        message(FATAL_ERROR "${source}: expected ${count} occurrences of ${needle}, got ${actual}")
    endif()
endfunction()

