# Regression guard for the GOG-only missing timer mapping. This checks address
# coverage/order, not native ABI compatibility or runtime pacing quality.
file(READ "${SOURCE_DIR}/main.cpp" main)
file(READ "${SOURCE_DIR}/gogmap.inc" gog)
string(FIND "${main}" "typedef void (__fastcall *TimerUpdate_t)" first)
string(FIND "${main}" "static void InstallInlineDrawHooks()" last)
if(first LESS 0 OR last LESS first)
    message(FATAL_ERROR "Cannot identify the frame pacing adapters")
endif()
math(EXPR length "${last}-${first}")
string(SUBSTRING "${main}" ${first} ${length} pacing)
string(REGEX MATCHALL "A\\(0x[0-9A-Fa-f]+\\)" addresses "${pacing}")
if(NOT addresses)
    message(FATAL_ERROR "No native pacing addresses found")
endif()
foreach(address IN LISTS addresses)
    string(REGEX REPLACE "A\\((0x[0-9A-Fa-f]+)\\)" "\\1" va "${address}")
    string(REGEX MATCH "\\{ ${va}, (0x[0-9A-Fa-f]+) \\}" entry "${gog}")
    if(NOT entry OR CMAKE_MATCH_1 STREQUAL "0x00000000")
        message(FATAL_ERROR "GOG frame pacing has no mapping for ${va}")
    endif()
endforeach()

# Xlate uses binary search: adding a valid entry out of order still breaks it.
string(REGEX MATCHALL "\\{ 0x[0-9A-Fa-f]+, 0x[0-9A-Fa-f]+ \\}" entries "${gog}")
set(previous 0)
foreach(entry IN LISTS entries)
    string(REGEX REPLACE "\\{ (0x[0-9A-Fa-f]+),.*" "\\1" va "${entry}")
    math(EXPR current "${va}")
    if(current LESS_EQUAL previous)
        message(FATAL_ERROR "GOG address map is not strictly sorted at ${va}")
    endif()
    set(previous ${current})
endforeach()
message(STATUS "GOG pacing address coverage and map ordering verified (source only)")
