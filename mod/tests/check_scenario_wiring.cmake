# Topology only. Compiled production/debug DLL inspection is a separate gate.
foreach(name xr main arms controls scenario_runner)
    file(READ "${SOURCE_DIR}/${name}.cpp" ${name})
endforeach()
file(READ "${SOURCE_DIR}/scenario_runner.h" header)
function(need source needle)
    string(FIND "${${source}}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing scenario adapter wiring in ${source}: ${needle}")
    endif()
endfunction()
function(before source a b)
    string(FIND "${${source}}" "${a}" first)
    string(FIND "${${source}}" "${b}" second)
    if(first LESS 0 OR second LESS 0 OR NOT first LESS second)
        message(FATAL_ERROR "Scenario adapter order: ${a} must precede ${b}")
    endif()
endfunction()
